PORT=3000
PUBLIC_HOST=http://localhost:3000
BASE_PATH=
DAILY_UPLOAD_LIMIT=5
MAX_FILE_SIZE_MB=50
DATA_DIR=./data

# SMTP email configuration (WeCom corporate email: smtp.exmail.qq.com)
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_ACCOUNT=noreply@tiangongtech.cn
SMTP_FROM=noreply@tiangongtech.cn
WECOM_CORPSECRET=your_smtp_password_here

# Auth token secret — generate a random string
TOKEN_SECRET=change-me-to-a-random-string
TOKEN_EXPIRY_SECONDS=86400
VERIFICATION_CODE_EXPIRY_SECONDS=600
